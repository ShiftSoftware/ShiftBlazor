@using ShiftSoftware.ShiftEntity.Model
@using static MudBlazor.Icons.Material
@inject ClipboardService Clip
@inject MessageService MsgService
@namespace ShiftSoftware.ShiftBlazor.Components
@implements IShortcutComponent
@inject ShiftBlazorLocalizer Loc

<MudPaper Elevation="25" Style="height: 100%;">
    <MudFocusTrap DefaultFocus="DefaultFocus.Element">
        <MudAppBar Color="@Color" Fixed="false" Dense Elevation="0">
             <MudIcon Icon="@Icon" />
             <MudText title="@Message.Title" Class="px-4 text-overflow-ellipsis" Style="margin:0;">@Message.Title</MudText>

            <MudSpacer />

            <MudIconButtonExtended KeyboardKey="KeyboardKeys.Escape"
                                   Size="Size.Medium"
                                   OnClick="() => Close(true)"
                                   Icon="@Icons.Material.Filled.Close"
                                   Edge="Edge.End"
                                   Color="Color.Inherit"
                                   title="@Loc["ClosePopupButtonLabel"]" />
        </MudAppBar>

        <div class="pa-6">

            @if (MessageBodyTemplate == null)
            {
                <MudText Style="word-wrap: break-word;">@Message.Body</MudText>

                @if (Message.SubMessages?.Count > 0)
                {
                    <MudList T="object">
                        @foreach (var msg in Message.SubMessages)
                        {
                            <MessageList Message="msg"></MessageList>
                        }
                    </MudList>
                }
            }
            else
            {
                @MessageBodyTemplate(Message)
            }

            @if (RequiresTypedConfirmation)
            {
                var (before, after) = TypeToConfirmInstruction;

                <MudText Class="mt-4 mb-2" Style="word-wrap: break-word;">@before<b>@TypeToConfirm!.Trim()</b>@after</MudText>
                <MudTextField T="string"
                              @bind-Value="TypedConfirmation"
                              Immediate="true"
                              AutoFocus="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              autocomplete="off"
                              spellcheck="false"
                              OnKeyDown="OnTypedConfirmationKeyDown" />
            }

        </div>

        <MudToolBar Dense>
            <MudSpacer />
            @if (ReportButton)
            {
                <MudButton Variant="Variant.Text" OnClick="CopyToClipboard">@Loc["CopyButtonLabel"]</MudButton>
            }

            @if (!string.IsNullOrWhiteSpace(CancelText))
            {
                <MudButtonExtended KeyboardKey="KeyboardKeys.Escape" Variant="Variant.Text" OnClick="() => Close(true)" Class="me-2">@CancelText</MudButtonExtended>
            }

            <MudButtonExtended KeyboardKey="KeyboardKeys.KeyS" Variant="Variant.Text" Color="@Color" Disabled="!CanConfirm" OnClick="() => Close()" Class="me-2">@(ConfirmText ?? Loc["ConfirmDefaultText"])</MudButtonExtended>
        </MudToolBar>
    </MudFocusTrap>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public Message Message { get; set; } = default!;

    [Parameter]
    public RenderFragment<Message>? MessageBodyTemplate { get; set; }

    [Parameter]
    public Color Color { get; set; } = Color.Warning;

    [Parameter]
    public string Icon { get; set; } = Filled.Warning;

    [Parameter]
    public string? ConfirmText { get; set; }

    [Parameter]
    public string? CancelText { get; set; }

    [Parameter]
    public bool ReportButton { get; set; }

    /// <summary>
    /// When set, the dialog shows a text field under the message and the confirm button stays disabled until
    /// the user types this text, for example "three". Letter case, extra spaces and hyphens are ignored, so
    /// "Twenty One" matches "twenty-one".
    /// </summary>
    [Parameter]
    public string? TypeToConfirm { get; set; }

    /// <summary>
    /// The instruction above the <see cref="TypeToConfirm"/> field, with {0} where the text to type goes.
    /// Defaults to: Type "{0}" below to confirm.
    /// </summary>
    [Parameter]
    public string? TypeToConfirmText { get; set; }

    [CascadingParameter]
    internal IMudDialogInstance? MudDialog { get; set; }

    public Guid Id { get; private set; } = Guid.NewGuid();
    public string Title { get; set; } = string.Empty;
    public Dictionary<KeyboardKeys, object> Shortcuts { get; set; } = new();

    protected override void OnInitialized()
    {
        Title = Message.Title;
        IShortcutComponent.Register(this);
    }

    private string? TypedConfirmation { get; set; }

    private bool RequiresTypedConfirmation => !string.IsNullOrWhiteSpace(TypeToConfirm);

    private bool CanConfirm => !RequiresTypedConfirmation
        || string.Equals(NormalizeTyped(TypedConfirmation), NormalizeTyped(TypeToConfirm), StringComparison.OrdinalIgnoreCase);

    // The instruction split around {0}, so the text to type can be shown in bold.
    private (string Before, string After) TypeToConfirmInstruction
    {
        get
        {
            var template = TypeToConfirmText;

            if (template is null)
            {
                var localized = Loc["TypeToConfirmInstruction"];

                // Apps on a localization package without this key still get a readable instruction.
                template = localized.ResourceNotFound ? "Type \"{0}\" below to confirm" : localized.Value;
            }

            var index = template.IndexOf("{0}", StringComparison.Ordinal);

            return index < 0 ? (template + " ", "") : (template[..index], template[(index + 3)..]);
        }
    }

    // Spaces and hyphens are treated alike and collapsed, so "twenty one", "twenty-one" and "Twenty  One" match.
    private static string NormalizeTyped(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        return string.Join(' ', text.Replace('-', ' ').Split(' ', StringSplitOptions.RemoveEmptyEntries));
    }

    private void OnTypedConfirmationKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanConfirm)
            Close();
    }

    public ValueTask HandleShortcut(KeyboardKeys key)
    {
        switch (key)
        {
            case KeyboardKeys.Escape:
                Close(true);
                break;

            case KeyboardKeys.KeyS:
                Close(false);
                break;
        }

        return new ValueTask();
    }

    private void Close(bool cancel = false)
    {
        // The confirm button is disabled until the typed text matches; Ctrl+S and Enter must not get around it.
        if (!cancel && !CanConfirm)
            return;

        if (cancel)
        {
            MudDialog?.Cancel();
        }
        else
        {
            MudDialog?.Close();
        }

        IShortcutComponent.Remove(Id);
    }

    private async Task CopyToClipboard()
    {
        try
        {
            var msg = System.Text.Json.JsonSerializer.Serialize(Message);
            await Clip.WriteTextAsync(msg);
            MsgService.Success(Loc["CopyActionSuccess"]);
        }
        catch (Exception)
        {
            MsgService.Error(Loc["CopyActionFail"]);
        }
    }

    public void Dispose()
    {
        IShortcutComponent.Remove(Id);
    }
}
