@namespace ShiftSoftware.ShiftBlazor.Components
@using System.Text.Json
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using System.Reflection
@using System.ComponentModel.DataAnnotations
@implements IDisposable

@inject SettingManager SettingManager
@inject ShiftBlazorLocalizer Loc
@inject IServiceProvider serviceProvider

@switch (LanguageLayout)
{
    case LanguageLayout.Row:
        <div class="d-flex" style="gap: 16px; overflow-x: auto; padding: 4px 0;">
            @foreach (var lang in Values.Keys)
            {
                <div @key="lang" style="flex: 1 0 240px; min-width: 0;">@Input(lang)</div>
            }
        </div>
        break;

    case LanguageLayout.Stacked:
        <div class="d-flex flex-column" style="gap: 8px;">
            @foreach (var lang in Values.Keys)
            {
                <div @key="lang">@Input(lang)</div>
            }
        </div>
        break;

    case LanguageLayout.Dropdown:
        <div class="d-flex align-start" style="gap: 8px;">
            <div style="flex: 1 1 auto; min-width: 0;">
                @foreach (var lang in Values.Keys)
                {
                    <div @key="lang" style="@(lang == selectedLanguage ? null : "display: none;")">@Input(lang)</div>
                }
            </div>
            <div style="flex: none; padding-top: 18px;">
                <LocalizedLanguageSwitch Options="@LanguageOptions()" @bind-Selected="selectedLanguage" />
            </div>
        </div>
        break;

    case LanguageLayout.Tabs:
        <MudTabs @bind-ActivePanelIndex="SelectedIndex" KeepPanelsAlive Elevation="0" ApplyEffectsToContainer TabPanelsClass="pt-2">
            @foreach (var option in LanguageOptions())
            {
                <MudTabPanel @key="option.Code"
                             Text="@option.Label"
                             BadgeDot="@(option.HasError || option.HasContent)"
                             BadgeColor="@(option.HasError ? Color.Error : Color.Success)">
                    @Input(option.Code)
                </MudTabPanel>
            }
        </MudTabs>
        break;

    case LanguageLayout.Expandable:
        var first = Values.Keys.FirstOrDefault();
        var hidden = Values.Keys.Skip(1).ToList();
        if (first != null)
        {
            <div>
                <div class="d-flex align-start" style="gap: 8px;">
                    <div @key="first" style="flex: 1 1 auto; min-width: 0;">@Input(first)</div>
                    @if (hidden.Count > 0)
                    {
                        <div style="flex: none; padding-top: 18px;">
                            <MudBadge Visible="@hidden.Any(Errors.ContainsKey)" Dot="true" Color="Color.Error" Overlap="true">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Style="min-width: 0; padding: 2px 6px 2px 10px;"
                                           EndIcon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                           OnClick="@(() => expanded = !expanded)">
                                    +@hidden.Count
                                </MudButton>
                            </MudBadge>
                        </div>
                    }
                </div>
                <div style="display: @(expanded ? "flex" : "none"); flex-direction: column; gap: 8px; margin-top: 8px;">
                    @foreach (var lang in hidden)
                    {
                        <div @key="lang">@Input(lang)</div>
                    }
                </div>
            </div>
        }
        break;

    default:
        <MudGrid>
            @foreach (var lang in Values.Keys)
            {
                <MudItem @key="lang" xs="xsColSize" sm="smColSize" md="mdColSize" lg="lgColSize">@Input(lang)</MudItem>
            }
        </MudGrid>
        break;
}

@code {
    [CascadingParameter(Name = "ShiftForm")]
    public IShiftForm? ShiftEntityForm { get; set; }

    [CascadingParameter]
    public IFormSection? FormSection { get; set; }

    [Parameter]
    public RenderFragment<LocalizedInputContext>? ChildContent { get; set; }

    /// <summary>
    /// The value of this input element.
    /// </summary>
    [Parameter]
    public string Value { get; set; } = default!;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// If string has value the label text will be displayed in the input, and scaled down at the top if the input has value.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Specify an expression which returns the model's field for which validation messages should be displayed.
    /// If value is null, validation will be skipped for this field.
    /// </summary>
    [Parameter]
    public Expression<Func<string?>>? For { get; set; }

    [Parameter]
    public List<LanguageInfo>? Languages { get; set; }

    /// <summary>
    /// How the languages are laid out. Defaults to <see cref="LanguageLayout.Grid"/>.
    /// </summary>
    [Parameter]
    public LanguageLayout LanguageLayout { get; set; }

    private int xsColSize;
    private int smColSize;
    private int mdColSize;
    private int lgColSize;

    [CascadingParameter]
    private EditContext? EditContext { get; set; }
    private EditContext? validatedContext;
    private Dictionary<string, string> Values { get; set; } = new();
    private Dictionary<string, string> Errors { get; set; } = new();
    private IEnumerable<ValidationAttribute>? validationAttributes;
    private string modelName = string.Empty;
    private string? fieldName;
    private ILookup<string, LanguageInfo> languageLookup = Enumerable.Empty<LanguageInfo>().ToLookup(x => x.CultureName);
    private string? languageSignature;
    private string selectedLanguage = string.Empty;
    private bool expanded;

    private int SelectedIndex
    {
        get => Values.Keys.ToList().IndexOf(selectedLanguage);
        set => selectedLanguage = Values.Keys.ElementAtOrDefault(value) ?? selectedLanguage;
    }

    protected override void OnInitialized()
    {
        // From here we deal with validations
        // If For is null, we skip validations
        if (For == null || EditContext == null)
        {
            return;
        }

        FormSection?.Add(FieldIdentifier.Create(For));

        // get the model name for error message replacement
        // e.g. "The ProductDTO field is required." => "The [Label] field is required."
        modelName = EditContext.Model.GetType().Name;

        var expression = (MemberExpression?)For.Body;
        if (expression?.Member != null)
        {
            // get validation attributes for this field
            // so that we can validate the value for each language input separately
            validationAttributes = expression.Member.GetCustomAttributes<ValidationAttribute>();
            fieldName = expression.Member.Name;
        }

        validatedContext = EditContext;
        validatedContext.OnValidationRequested += OnValidationRequested;
    }

    protected override void OnParametersSet()
    {
        var languages = Languages ?? SettingManager.Configuration.ContentLanguages;
        var signature = string.Join("|", languages.Select(x => $"{x.CultureName}:{x.Label}"));

        if (signature != languageSignature)
        {
            languageSignature = signature;
            LoadLanguages(languages);
        }
    }

    private void LoadLanguages(List<LanguageInfo> languages)
    {
        languageLookup = languages
            .ToLookup(x => new System.Globalization.CultureInfo(x.CultureName).TwoLetterISOLanguageName, x => x);

        var langCodes = languageLookup.Select(x => x.Key).Distinct().ToList();
        var stored = ParseStoredValues();
        var previous = Values;

        Values = langCodes.ToDictionary(
            lang => lang,
            lang => previous.TryGetValue(lang, out var current) ? current : stored.GetValueOrDefault(lang) ?? string.Empty);

        foreach (var lang in Errors.Keys.Except(langCodes).ToList())
        {
            Errors.Remove(lang);
        }

        if (!Values.ContainsKey(selectedLanguage))
        {
            selectedLanguage = langCodes.FirstOrDefault() ?? string.Empty;
        }

        var langCount = Math.Max(langCodes.Count, 1);
        xsColSize = 12;
        smColSize = Math.Max(12 / langCount, 6);
        mdColSize = Math.Max(12 / langCount, 4);
        lgColSize = Math.Max(12 / langCount, 3);
    }

    private Dictionary<string, string> ParseStoredValues()
    {
        if (string.IsNullOrWhiteSpace(Value))
        {
            return new();
        }

        try
        {
            // LocalizedTextField expects a JSON string in the format {"en":"Hello","fr":"Bonjour"}
            var json = JsonDocument.Parse(Value);
            return json.Deserialize<Dictionary<string, string>>() ?? new();
        }
        catch
        {
            // if Value is not a valid json, we ignore the error and use the raw value
            var lang = new System.Globalization.CultureInfo(DefaultAppSetting.Language.CultureName).TwoLetterISOLanguageName;
            return new() { [lang] = Value };
        }
    }

    private RenderFragment Input(string lang) => builder =>
    {
        if (ChildContent != null)
        {
            builder.AddContent(0, ChildContent(ContextFor(lang)));
        }
    };

    private LocalizedInputContext ContextFor(string lang)
    {
        var langLabel = languageLookup[lang].FirstOrDefault()?.Label;
        var label = Label == null
            ? langLabel
            : string.IsNullOrWhiteSpace(langLabel)
                ? $"{Label}"
                : $"{Label} ({Loc[langLabel].Value})";

        Errors.TryGetValue(lang, out var errorMessage);
        errorMessage = string.IsNullOrWhiteSpace(errorMessage) ? null : errorMessage.Replace(modelName, fieldName);

        return new LocalizedInputContext(Values[lang], value => TextChanged(lang, value), label, errorMessage != null, errorMessage);
    }

    private List<LocalizedLanguageOption> LanguageOptions() =>
        Values.Select(x =>
        {
            var label = languageLookup[x.Key].FirstOrDefault()?.Label;
            return new LocalizedLanguageOption(
                x.Key,
                string.IsNullOrWhiteSpace(label) ? x.Key.ToUpperInvariant() : Loc[label].Value,
                !string.IsNullOrWhiteSpace(x.Value),
                Errors.ContainsKey(x.Key));
        }).ToList();

    private void OnValidationRequested(object? sender, ValidationRequestedEventArgs eventArgs)
    {
        foreach (var (lang, value) in Values)
        {
            ValidateField(lang, value);
        }

        // Add the error to the form's EditContext/MessageStore
        // so that we can prevent the form from being submitted
        if (Errors.Count != 0 && fieldName != null && ShiftEntityForm != null)
        {
            ShiftEntityForm.DisplayError(fieldName, Errors.First().Value);
        }

        if (RevealFirstError())
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private bool RevealFirstError()
    {
        var firstInvalid = Values.Keys.FirstOrDefault(Errors.ContainsKey);
        if (firstInvalid == null)
        {
            return false;
        }

        if (LanguageLayout is LanguageLayout.Dropdown or LanguageLayout.Tabs && !Errors.ContainsKey(selectedLanguage))
        {
            selectedLanguage = firstInvalid;
            return true;
        }

        if (LanguageLayout == LanguageLayout.Expandable && !expanded && Values.Keys.Skip(1).Any(Errors.ContainsKey))
        {
            expanded = true;
            return true;
        }

        return false;
    }

    public async Task TextChanged(string lang, string newValue)
    {
        Values[lang] = newValue;
        ValidateField(lang, newValue);

        Value = JsonSerializer.Serialize(Values);
        await this.ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }

    private void ValidateField(string lang, string value)
    {
        if (validationAttributes != null && EditContext != null)
        {
            var errors = EditContext.ValidateDataAnnotationValue(value, validationAttributes);

            if (errors.Count == 0 && fieldName != null)
                errors = EditContext.ValidateFluentValidationValue(value, fieldName, serviceProvider, ShiftEntityForm?.Validator);

            if (errors.Count == 0)
            {
                Errors.Remove(lang);
            }
            else
            {
                Errors[lang] = errors.First();
            }
        }
    }

    public void Dispose()
    {
        if (validatedContext != null)
        {
            validatedContext.OnValidationRequested -= OnValidationRequested;
        }
    }
}
