<ShiftList T="User"
           Title="Action Button"
           EnableSelection
           @bind-Values="Users">

    <ToolbarStartTemplate>
        <ActionButton T="User" Class="action-button" @attributes="ButtonParameters">Run Action</ActionButton>
    </ToolbarStartTemplate>

    <ChildContent>
        <PropertyColumn Property="x => x.Name" />
        <PropertyColumn Property="x => x.Email" />
    </ChildContent>
</ShiftList>

@code {
    [Parameter]
    public List<User> Users { get; set; } = User.GenerateData(50, 50, false);

    /// <summary>The parameters of the action button under test.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? ButtonParameters { get; set; }
}
